{
  "name": "accidental-archmage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accidental Archmage — a slapstick isometric tactical roguelite prototype (Three.js + TypeScript + Vite)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
